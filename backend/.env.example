# 학식(/cafeteria/week) 데이터 소스 설정
#
# CAFETERIA_PROVIDER=mock (기본값, 미설정 시)
#   -> 더미 데이터([])를 반환. OPENAI_API_KEY 없이도 항상 동작.
# CAFETERIA_PROVIDER=llm
#   -> 백엔드가 kw.ac.kr 학식 페이지를 직접 fetch한 뒤
#      OPENAI_API_KEY로 OpenAI Structured Outputs를 호출해 구조화 추출.
#      이 모드를 쓰려면 아래 OPENAI_API_KEY가 반드시 필요함.
CAFETERIA_PROVIDER=mock

# CAFETERIA_PROVIDER=llm일 때만 필요. 실제 키는 이 파일이 아니라
# .env(gitignore됨) 또는 배포 환경의 환경 변수로만 설정할 것.
OPENAI_API_KEY=
